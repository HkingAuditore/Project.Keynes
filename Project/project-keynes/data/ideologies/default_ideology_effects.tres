script = ExtResource("2_effect")
definition_key = &"v3_vein_dominance"
target_domain = 2
operation = 1
lifecycle = 0
duration_days = -1
stack_policy = 0
stack_key = &"v3_vein_dominance"
max_stacks = 1
priority = 0
target_selector_kind = 6
target_selector_id = &""
target_selector_param = PackedInt32Array(8, 0)
cadence_days = 1
conditions = Array[Resource]([SubResource("CondVeinDominance")])
instructions = Array[Resource]([SubResource("InstrVeinDominance"), SubResource("InstrGranaryBeltEmit")])
commands = Array[Resource]([SubResource("CmdVeinDominance")])

; ── V4 铁王座 ─────────────────────────────────────────────────────────────────
; 条件：主导资源存量占比 >= 50%（metric 44），即这块地专精某一种资源。
; 目标：自身格 + R2 的 18 格，全城产出 +8%。
; 说明：要锁死「就是铁」需把 op 换成 METRIC_EQ(4) 并把 arg0 指向 metric 43
; (cell.dominant_resource_id)、value_q16 填 building_resource_ids 里铁的下标。
; 那是内容期的事，这里先验证「资源专精 -> 目标扩张」这条形态。
[sub_resource type="Resource" id="InstrIronThrone"]
script = ExtResource("4_instruction")
op = 1
value_q16 = 262144

[sub_resource type="Resource" id="CondIronThrone"]
script = ExtResource("3_condition")
op = 2
arg0 = 44
value_q16 = 32768

[sub_resource type="Resource" id="CmdIronThrone"]
