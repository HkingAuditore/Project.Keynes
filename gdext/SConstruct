#!/usr/bin/env python
"""
SConstruct for ProjectKeynes DOTS GDExtension (`dots_ext`).

Targets Godot 4.6.x via godot-cpp master (pinned by submodule).

Build commands (run from gdext/ directory in a VS 2022 x64 Native Tools Command Prompt):
    scons platform=windows target=template_debug
    scons platform=windows target=template_release
    scons platform=linux   target=template_debug
    scons platform=android target=template_release arch=arm64

Web (needs emsdk 4.0.20 activated — must match the Emscripten version used to build
the official Godot 4.6 templates, otherwise the side module fails to load):
    scons platform=web target=template_release arch=wasm32 threads=no lto=none

Output goes directly into the Godot project's addons/dots_ext/bin/<platform>/
so no manual copy step is required after a build.
"""
import os
import re

# The native runtime uses standard C++ exceptions for invariant failures and
# catches them at the worker boundary. godot-cpp disables exceptions by default
# on non-Web targets, so make the requirement explicit for every platform.
ARGUMENTS.setdefault("disable_exceptions", "no")

# Inherit the godot-cpp environment (it sets up compiler flags, include paths,
# and exposes env["platform"], env["suffix"], env["SHLIBSUFFIX"], etc.).
#
# GODOT_CPP_DIR lets one build use a private godot-cpp checkout. The generated
# bindings in godot-cpp/gen are architecture-specific (32-bit wasm32 vs 64-bit
# x86_64 builtin sizes), so a concurrent web build regenerating the shared gen/
# silently produces Windows DLLs that crash Godot at startup. Default unchanged.
_godot_cpp_dir = os.environ.get("GODOT_CPP_DIR", "godot-cpp")
env = SConscript(os.path.join(_godot_cpp_dir, "SConstruct"))

# ---------------------------------------------------------------------------
# Source layout
# ---------------------------------------------------------------------------
env.Append(CPPPATH=["src/"])

if env["platform"] == "windows" and env.get("is_msvc", False):
    # NativeSimulationHost catches domain faults at the thread boundary; make
    # the MSVC exception model explicit instead of relying on toolchain defaults.
    env.Append(CCFLAGS=["/EHsc"])

# ---------------------------------------------------------------------------
# SIMD / vectorisation flags (Phase 3 micro-bench — methods C: SIMD path).
# Toggle off if you suspect AVX2 isn't available on a target machine.
# AVX2 baseline = Intel Haswell (2013) / AMD Excavator (2015), ~ universal now.
# Build with `scons platform=windows target=template_debug avx2=no` to disable.
# ---------------------------------------------------------------------------
opts = Variables()
opts.Add(BoolVariable("avx2", "Enable AVX2 codegen for SIMD bench paths", True))
opts.Add(BoolVariable("runtime_lto", "Enable MSVC cross-file optimization for optimized native runtime builds", True))
# WebAssembly SIMD128（Chrome 91+/Firefox 89+/Safari 16.4+）。默认关，首次 bring-up
# 先用最保守的字节码；确认能跑之后再 `wasm_simd=yes` 找回一部分标量路径的损失。
opts.Add(BoolVariable("wasm_simd", "Enable WebAssembly SIMD128 (web only)", False))
opts.Update(env)

# AVX2 / FMA only make sense on x86_64. Apple Silicon (arm64) + ARM Linux + Android
# arm64 use NEON instead; emitting `-mavx2 -mfma` there fails compilation (clang:
# "unsupported option for target 'arm64-...'"). Gate by both platform AND arch.
_arch_is_x86_64 = env.get("arch", "") in ("x86_64", "x86", "")  # "" → autodetect, typically x86_64 on CI Windows/Linux hosts
if env["avx2"] and _arch_is_x86_64:
    if env["platform"] == "windows" and env.get("is_msvc", False):
        # MSVC: /arch:AVX2 also implicitly enables FMA + BMI1/2.
        env.Append(CCFLAGS=["/arch:AVX2"])
        env.Append(CPPDEFINES=["PK_HAVE_AVX2=1"])
    elif env["platform"] in ("linux", "linuxbsd", "macos"):
        env.Append(CCFLAGS=["-mavx2", "-mfma"])
        env.Append(CPPDEFINES=["PK_HAVE_AVX2=1"])
    # else: skip on android/ios/web — those targets pick their own arch.
else:
    # 包含 avx2=no 显式关闭 与 arm64 / android arm / web wasm32 等非 x86_64 架构。
    env.Append(CPPDEFINES=["PK_HAVE_AVX2=0"])

if env["platform"] == "web" and env["wasm_simd"]:
    env.Append(CCFLAGS=["-msimd128"])
    env.Append(LINKFLAGS=["-msimd128"])

# godot-cpp's MSVC auto mode disables LTO. Clone before applying extension-only
# flags: the library builders retain the original environment. Hot loops can
# then inline exact fixed-point helpers across domain source files.
env = env.Clone()
# Simulation arithmetic must round the same way on hardware with and without
# fused multiply-add, including WebAssembly's scalar floating-point operations.
if env.get("is_msvc", False):
    # MSVC /fp:strict disables FMA contraction on C++ code, but in C11 mode it
    # rejects constant floating-point arithmetic in musl static initializers
    # (C2099). Compile C files with /fp:precise and disable FMA via
    # `#pragma fp_contract(off)` in thirdparty/simulation_math/libm.h.
    env.AppendUnique(CXXFLAGS=["/fp:strict"])
    env.AppendUnique(CFLAGS=["/std:c11", "/fp:precise"])
else:
    env.AppendUnique(CCFLAGS=["-ffp-contract=off"])

if (env["runtime_lto"] and env["platform"] == "windows" and
        env.get("is_msvc", False) and env["optimize"] in ("speed", "speed_trace")):
    env.AppendUnique(CCFLAGS=["/GL"])
    env.AppendUnique(LINKFLAGS=["/LTCG"])

sources = (
    Glob("src/*.cpp")
    + Glob("src/components/*.cpp")
    + Glob("src/systems/*.cpp")
    + Glob("src/profiles/*.cpp")
    + Glob("thirdparty/simulation_math/*.c")
)

# ---------------------------------------------------------------------------
# Output path: drop the shared library straight into the Godot addons folder.
# Path is relative to gdext/, walking up one level to reach Project/...
# ---------------------------------------------------------------------------
addons_bin = "../Project/project-keynes/addons/dots_ext/bin/"

platform = env["platform"]
output_basename = os.environ.get("DOTS_EXT_OUTPUT_BASENAME", "dots_ext")
if platform == "windows" and "DOTS_EXT_OUTPUT_BASENAME" not in os.environ:
    # Upstream changes the loaded DLL name as interfaces evolve. Build the
    # name selected by the manifest so a successful rebuild cannot leave
    # Godot loading an older, differently named DLL.
    manifest_path = os.path.join(addons_bin, "..", "dots_ext.gdextension")
    with open(manifest_path, encoding="utf-8") as manifest_file:
        manifest = manifest_file.read()
    variant = "release" if env["target"] == "template_release" else "debug"
    key = "windows.{}.{}".format(variant, env["arch"])
    match = re.search(r'^' + re.escape(key) + r'\s*=\s*"res://[^"\n]*/([^/"\n]+)\.windows\.',
                      manifest, re.MULTILINE)
    if match is None:
        raise ValueError("Missing Windows library mapping: " + key)
    output_basename = match.group(1)
if platform == "windows":
    output_path = addons_bin + "windows/{}{}{}".format(
        output_basename, env["suffix"], env["SHLIBSUFFIX"]
    )
elif platform == "linux" or platform == "linuxbsd":
    output_path = addons_bin + "linux/libdots_ext{}{}".format(
        env["suffix"], env["SHLIBSUFFIX"]
    )
elif platform == "macos":
    output_path = addons_bin + "macos/libdots_ext{}{}".format(
        env["suffix"], env["SHLIBSUFFIX"]
    )
elif platform == "android":
    output_path = addons_bin + "android/libdots_ext{}{}".format(
        env["suffix"], env["SHLIBSUFFIX"]
    )
elif platform == "web":
    # godot-cpp/tools/web.py 把 SHLIBSUFFIX 设成 ".wasm" 并加 -sSIDE_MODULE=1；
    # threads=no 时 env["suffix"] 会自带 ".nothreads"，与 .gdextension 里
    # web.*.wasm32（无 threads 特性标签）那两条 key 对应。
    output_path = addons_bin + "web/libdots_ext{}{}".format(
        env["suffix"], env["SHLIBSUFFIX"]
    )
else:
    raise ValueError("Unsupported platform for dots_ext: " + platform)

if platform == "android":
    # NDK r30 的 libc++ ABI 比 Godot 4.6.2 Android 模板自带的 libc++_shared.so 新：
    # 默认动态链接会让 .so 引用 __hash_memory 等新符号，真机/模拟器 dlopen 直接失败：
    #   cannot locate symbol "_ZNSt6__ndk113__hash_memoryEPKvm"
    #   -> GDExtension entry point 'dots_ext_init' not found
    # 静态链 libc++ 让这些符号在库内解析（已验证 undefined libc++ 符号 = 0）。
    # --exclude-libs,ALL 防止把静态 libc++ 的符号导出到动态符号表，避免和引擎那份
    # libc++_shared.so 互相插桩。
    env.Append(LINKFLAGS=["-static-libstdc++", "-Wl,--exclude-libs,ALL"])

if platform == "web":
    # The web link exceeds the Windows command-line limit.
    #
    # On Windows emcc/em++ are .bat launchers, so the whole command line is
    # expanded by cmd.exe, which caps it at 8191 characters. This extension is
    # 351 translation units: `em++ -o <target> <flags> <351 .o>` is roughly
    # 20k characters, so the link died with "The command line is too long."
    # right after every object had compiled (2026-11-23) - i.e. a full compile
    # followed by no artifact at all.
    #
    # emcc reads `@file` response files very early (emcc.py calls
    # tools/response_file.substitute_response_files()), and godot-cpp's
    # tools/web.py already wraps ARCOM in ${TEMPFILE(ARCOM_POSIX)} for exactly
    # this reason. Only the link was left unwrapped. Same idiom here.
    #
    # Two details the AR wrapper already got right and this must match:
    #   * Wrap the WHOLE command, not just $SOURCES: TempFileMunge keeps cmd[0]
    #     (the program) on the real command line and writes the rest to the
    #     response file, so a $SOURCES-only wrap would leak the first object
    #     path out as the "program".
    #   * Use POSIX paths: the response file is parsed with shlex, which eats
    #     backslashes as escapes, so "src\foo.o" would arrive as "srcfoo.o".
    #
    #   * Every argument written to the file must use forward slashes. $SOURCES
    #     can be redirected with .posix, but the static library comes through
    #     $_LIBFLAGS as an already-formatted string ("godot-cpp\bin\lib..."):
    #     shlex turned that into "godot-cppbinlibgodot-cpp...a". So escape at
    #     the source instead, with the hook the SCons manual documents for this
    #     exact case (TEMPFILEARGESCFUNC - "GCC ... let's use UNIX separator").
    env["SHLINKCOM_POSIX"] = env["SHLINKCOM"].replace(
        "$TARGET", "$TARGET.posix").replace("$SOURCES", "$SOURCES.posix")
    env["SHLINKCOM"] = "${TEMPFILE(SHLINKCOM_POSIX)}"

    from SCons.Subst import quote_spaces

    def _pk_tempfile_arg_esc(arg):
        return quote_spaces(arg).replace("\\", "/")

    env["TEMPFILEARGESCFUNC"] = _pk_tempfile_arg_esc

# Expose object nodes directly as link inputs so the incremental build graph
# includes every source and compiler setting at the object boundary.
objects = env.SharedObject(sources)
library = env.SharedLibrary(output_path, source=objects)
Default(library)
