[sub_resource type="Resource" id="SynergyGranaries"]
script = ExtResource("6_synergy")
id = &"synergy.planned_granaries"
required_ideology_ids = PackedStringArray("idea.collective_stewardship", "idea.scholar_office")
minimum_levels = PackedInt32Array(0, 0)
location_masks = PackedByteArray(6, 6)
persistent_effects = Array[Resource]([SubResource("EffectSynergy")])

[sub_resource type="Resource" id="SynergyCharter"]
script = ExtResource("6_synergy")
id = &"synergy.chartered_frontier"
required_ideology_ids = PackedStringArray("idea.free_exchange", "idea.civic_muster")
minimum_levels = PackedInt32Array(0, 0)
location_masks = PackedByteArray(6, 6)
persistent_effects = Array[Resource]([SubResource("EffectSynergy")])

[resource]
script = ExtResource("1_catalog")
profile = SubResource("Profile")
definitions = Array[Resource]([SubResource("Collective"), SubResource("Exchange"), SubResource("Scholar"), SubResource("Civic")])
synergies = Array[Resource]([SubResource("SynergyGranaries"), SubResource("SynergyCharter")])
