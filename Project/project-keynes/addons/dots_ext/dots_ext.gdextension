[configuration]

entry_symbol = "dots_ext_init"
compatibility_minimum = "4.4"
compatibility_maximum = "4.6"

[libraries]

windows.debug.x86_64    = "res://addons/dots_ext/bin/windows/dots_ext_fiscal_cashcap_v1.windows.template_debug.x86_64.dll"
windows.release.x86_64  = "res://addons/dots_ext/bin/windows/dots_ext_fiscal_cashcap_v1.windows.template_release.x86_64.dll"
linux.debug.x86_64      = "res://addons/dots_ext/bin/linux/libdots_ext.linux.template_debug.x86_64.so"
linux.release.x86_64    = "res://addons/dots_ext/bin/linux/libdots_ext.linux.template_release.x86_64.so"
macos.debug.arm64       = "res://addons/dots_ext/bin/macos/libdots_ext.macos.template_debug.arm64.dylib"
macos.release.arm64     = "res://addons/dots_ext/bin/macos/libdots_ext.macos.template_release.arm64.dylib"
macos.debug.x86_64      = "res://addons/dots_ext/bin/macos/libdots_ext.macos.template_debug.x86_64.dylib"
macos.release.x86_64    = "res://addons/dots_ext/bin/macos/libdots_ext.macos.template_release.x86_64.dylib"
android.debug.arm64     = "res://addons/dots_ext/bin/android/libdots_ext.android.template_debug.arm64.so"
android.release.arm64   = "res://addons/dots_ext/bin/android/libdots_ext.android.template_release.arm64.so"

; Web 侧模块有两套产物，必须与导出预设的 variant/thread_support 一致，否则
; pthread ABI 不匹配，side module 在浏览器里加载失败：
;   variant/thread_support=false -> web.*.wasm32（无特性标签）
;   variant/thread_support=true  -> web.*.threads.wasm32
web.debug.threads.wasm32    = "res://addons/dots_ext/bin/web/libdots_ext.web.template_debug.wasm32.wasm"
web.release.threads.wasm32  = "res://addons/dots_ext/bin/web/libdots_ext.web.template_release.wasm32.wasm"
web.debug.wasm32            = "res://addons/dots_ext/bin/web/libdots_ext.web.template_debug.wasm32.nothreads.wasm"
web.release.wasm32          = "res://addons/dots_ext/bin/web/libdots_ext.web.template_release.wasm32.nothreads.wasm"
