static inline uint8_t pk_whittaker_vegetation(float temperature, float moisture, uint8_t landform) {
    const bool is_alpine = (landform == 7 || landform == 8);
    const bool is_hilly = (landform == 6);
    if (temperature < 0.06f) return 1; 
    if (temperature < 0.20f) return is_alpine ? 3 : 2; 
    if (temperature < 0.40f) {
        if (moisture > 0.40f) return is_alpine ? 8 : 5; 
        if (moisture > 0.20f) return 6; 
        return is_alpine ? 3 : 10; 
    }
    if (temperature < 0.55f) {
        
        if (moisture > 0.42f) return is_alpine ? 8 : (is_hilly ? 7 : 7);
        if (moisture > 0.26f) return is_alpine ? 4 : 9; 
        return is_alpine ? 6 : 10; 
    }
    
    
    if (temperature < 0.80f) {       
        if (moisture > 0.40f) return 12; 
        if (moisture > 0.22f) return 9;  
        if (moisture < 0.12f) return 16; 
        return 10;                       
    }
    
    if (moisture > 0.64f) return 14; 
    if (moisture > 0.42f) return 25; 
    if (moisture > 0.34f) return 15; 
    
    if (moisture > 0.24f) return 13; 
    if (moisture < 0.10f) return 17; 
    return 16; 
}

static inline uint8_t pk_derive_vegetation(uint8_t terrain, uint8_t landform, float temperature, float moisture) {
    if (terrain == 0 || terrain == 18 || terrain == 20) return 0; 
    
    
    if (terrain == 1) return (temperature > 0.42f && temperature < 0.82f) ? 26 : 0; 
    if (terrain == 19) return 23; 
    if (terrain == 21) return 22; 
    if (terrain == 17) return 0;  
    if (terrain == 9) {
        if (landform == 6 || landform == 7) return 3; 
        if (landform == 8) return 0; 
        return 1; 
    }
    const bool is_alpine = (landform == 7 || landform == 8);
    const bool is_hilly = (landform == 6);
    if (landform == 8) return 0; 
    if (terrain == 22) return temperature < 0.55f ? 21 : 19; 
    if (terrain == 23) return 18; 
    if (terrain == 24) return 0;  
    if (terrain == 25) return 16; 
    
    if (terrain == 26) return moisture < 0.08f ? 17 : 16; 
    if (terrain == 27) return 11; 
    if (terrain == 28) return 27; 
    if (terrain == 29) {          
        if (temperature > 0.55f) return moisture > 0.60f ? 25 : 13; 
        return moisture > 0.70f ? 21 : 9; 
    }
    if (terrain == 30) return 16; 
    if (terrain == 10) return temperature < 0.34f ? 27 : 20; 
    if (terrain == 16) return 19; 
    if (terrain == 15) return 11; 
    if (terrain == 8) return is_alpine ? 3 : 2; 
    if (terrain == 13) return is_alpine ? 8 : 5; 
    if (terrain == 5 || terrain == 6 || terrain == 2) {
        return pk_whittaker_vegetation(temperature, moisture, landform);
    }
    switch (terrain) {
        case 4: 
            if (is_alpine) return 8;
            
            if (is_hilly && temperature > 0.50f && moisture > 0.52f) return 24; 
            return temperature > 0.55f ? 12 : 7; 
        case 11: 
            
            if ((is_alpine || is_hilly) && moisture > 0.60f) return 24; 
            if (moisture > 0.66f) return 14; 
            if (moisture > 0.50f) return 25; 
            return 15; 
        case 12: 
            if (is_alpine) return moisture > 0.45f ? 4 : 6; 
            
            
            return moisture > 0.64f ? 25 : 13; 
        case 3:  return is_alpine ? 4 : 9; 
        case 14: 
            if (is_alpine) return temperature < 0.28f ? 3 : (moisture > 0.32f ? 4 : 6);
            return 10;
        case 7:  return moisture < 0.10f ? 17 : 16; 
        default: return pk_whittaker_vegetation(temperature, moisture, landform);
    }
}

