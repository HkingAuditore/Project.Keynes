; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ProjectKeynes"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://assets/ui/paper_hud/app_icon.png"

[autoload]

GameSettings="*res://scripts/game/game_settings_service.gd"
GameAudio="*res://scripts/audio/game_audio_service.gd"
GameSave="*res://scripts/game/game_save_coordinator.gd"
GameFlow="*res://scripts/game/game_flow_service.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=10

[display]

window/size/viewport_width=1600
window/size/viewport_height=960
window/size/mode=2
window/stretch/aspect="expand"
; 手持方向：0=Landscape 1=Portrait 2=Reverse Landscape 3=Reverse Portrait
; 4=Sensor Landscape 5=Sensor Portrait 6=Sensor（枚举见 ProjectSettings hint）。
; Project.Keynes 是横屏大地图策略游戏：默认 0 会把方向锁死在「正握横屏」，
; 玩家反握时画面倒置且不会跟随。4 允许两个横屏方向互相切换（仍是横屏，不会转竖屏），
; 刘海/挖孔靠 DisplayServer.get_display_safe_area() + scripts/ui/mobile_ui_scaling.gd 避让。
; 实际像素缩放（content_scale_mode/factor）由 MobileUIScaling 在运行期按 dpi 设置，
; 这里刻意不写 window/stretch/mode：桌面端保持原生像素语义，避免非 1600×960 窗口回归。
window/handheld/orientation=4

[editor]

run/main_run_args="--use_data_core --use_data_core_weather"

[editor_plugins]

enabled=PackedStringArray("res://addons/climate_profile_inspector/plugin.cfg", "res://addons/loading_prebake/plugin.cfg", "res://addons/keynes_audio_export/plugin.cfg")

[input]

player_pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":32,"physical_keycode":32,"key_label":32,"unicode":32,"location":0,"echo":false,"script":null)
]
}
