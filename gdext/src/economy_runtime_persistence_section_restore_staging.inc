struct NativeEconomyRuntime::RestoreStagingSession {
    std::unique_ptr<NativeEconomyRuntime> runtime =
        std::make_unique<NativeEconomyRuntime>();
    decltype(modifier_api::copy_runtime(
        *static_cast<decltype(NativeEconomyRuntime::_modifier_runtime)>(nullptr))) modifier;
};

void NativeEconomyRuntime::RestoreStagingSessionDeleter::operator()(
        RestoreStagingSession *session) const {
    delete session;
}

void NativeEconomyRuntime::discard_staged_restore() {
    _restore_staged_session.reset();
    _restore = {};
}

NativeEconomyRuntime *NativeEconomyRuntime::staged_restore_runtime() const {
    return _restore_staged_session ? _restore_staged_session->runtime.get()
                                   : nullptr;
}

NativeEconomyRuntime *NativeEconomyRuntime::session_runtime(
        RestoreStagingSession &session) {
    return session.runtime.get();
}

NativeEconomyRuntime::RestoreStagingSessionPtr
NativeEconomyRuntime::create_staged_restore_session() const {
    RestoreStagingSessionPtr session(new RestoreStagingSession());
    NativeEconomyRuntime &staged = *session->runtime;
    // External peer pointers: keep read/query peers, redirect ModifierRuntime
    // to an isolated clone, and leave OwnedState/ResourceStore aliases null so
    // all staging writes stay inside `staged`.
    staged._country_runtime = _country_runtime;
    staged._simulation_host = _simulation_host;
    staged._csv_recorder = nullptr;
    staged._sync_writes_forbidden = _sync_writes_forbidden;
    staged._d7_operation_gate_mask = _d7_operation_gate_mask;
    staged._effect_runtime = _effect_runtime;
    staged._effect_forwarder = _effect_forwarder;
    // Never pass live _trigger_runtime into staging: reconcile_family_branch_effects
    // would mutate live TriggerRuntime before commit. Trigger bindings are reconciled
    // on `this` only after commit_staged_restore_session succeeds.
    staged._trigger_runtime = nullptr;
    staged._formula_owned = nullptr;
    staged._resource_store_alias = nullptr;
    staged._accept_stale_country_identity = _accept_stale_country_identity;
    if (_modifier_runtime != nullptr) {
        session->modifier = modifier_api::copy_runtime(*_modifier_runtime);
        modifier_api::attach_country_runtime(*session->modifier, _country_runtime);
        modifier_api::attach_economy_runtime(*session->modifier, &staged);
        staged._modifier_runtime = session->modifier.get();
    } else {
        session->modifier.reset();
        staged._modifier_runtime = nullptr;
    }

    // Core configuration flags, world shape, and catalog hashes.
    staged._configured = _configured;
    staged._cell_count = _cell_count;
    staged._seed = _seed;
    staged._catalog_hash = _catalog_hash;
    staged._catalog_compat_hash_v6 = _catalog_compat_hash_v6;
