[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/components/papercut_map_preview.gd" id="1_script"]

[node name="PapercutMapPreview" type="PanelContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_type_variation = &"PKPaperCard"
