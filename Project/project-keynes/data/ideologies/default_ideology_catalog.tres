[sub_resource type="Resource" id="Collective"]
script = ExtResource("3_definition")
id = &"idea.collective_stewardship"
icon_key = &"country.economy"
name_key = &"共同体治理"
detail_key = "以共同仓储、互助义务和长期土地责任组织生产。"
rarity_weight = 120
national_spirit_min_level = 1
class_stances = Array[Resource]([SubResource("CollectiveGeneral"), SubResource("CollectiveFarmer"), SubResource("CollectiveWorker"), SubResource("CollectiveTechnology")])
adopt_threshold_q16 = 8192
repeal_threshold_q16 = 0
promote_threshold_q16 = 16384
exclusion_group = &"economic_order"
levels = Array[Resource]([SubResource("LevelLow"), SubResource("LevelHigh")])

