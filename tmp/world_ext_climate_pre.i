        return std::chrono::duration<double, std::milli>(t1 - t0).count();
    }

    
    pk::parallel_for_range(
        "pk_ocean_land", n_land, n_tasks, 256,
        [&](int begin, int end) {
            ocean_land_run_land_range(ctx, land_idx.data(), begin, end);
        });

