        case 29: 
            w *= wet ? 1.16f : (arid ? 0.68f : 1.02f);
            break;
        case 30: 
            w *= arid ? 1.08f : 0.90f;
            break;
        case 10: 
            w *= wet ? 1.15f : 0.65f;
            break;
        case 16: 
            w *= (veg == 19) ? 1.20f : (wet ? 1.05f : 0.58f);
            break;
        case 15: 
            w *= (veg == 11) ? 1.14f : 0.92f;
            break;
        default:
            break;
    }

    if (landform == 7 || landform == 8) { 
        w *= alpine ? 1.16f : (arid && moisture > 0.45f ? 0.58f : 0.90f);
    } else if (landform == 6) { 
        w *= alpine ? 1.06f : 1.0f;
