{
  "repo": "hrhgit/Project.Keynes",
  "upstream": "HkingAuditore/Project.Keynes",
  "base": "master",
  "remote": "fork",
  "home": "~/.keynes-factory",
  "labels": {
    "trigger": "ready-for-agent",
    "working": "agent-working",
    "done": "agent-done",
    "help": "agent-needs-help"
  },
  "skipLabels": ["needs-investigation", "blocked"],
  "tools": {
    "python": "~/.local/bin/python3",
    "godot": "/opt/homebrew/bin/godot",
    "scons": "~/.local/bin/scons",
    "qodo": "~/.local/bin/qodo",
    "codex": "codex"
  },
  "agent": {
    "model": "gpt-6-luna",
    "effort": "high",
    "timeoutMinutes": 60
  },
  "limits": {
    "implementAttempts": 3,
    "localReviewRounds": 2,
    "localReviewRequired": false,
    "prReviewRounds": 3,
    "localReviewTimeoutMinutes": 30,
    "prReviewTimeoutMinutes": 40,
    "ciTimeoutMinutes": 40,
    "checkTimeoutMinutes": 45
  },
  "checks": {
    "staticWorkflow": ".github/workflows/runtime-checks.yml",
    "unit": [
      ["-m", "unittest", "discover", "-s", "tools/map_authoring/tests"]
    ],
    "nativePaths": ["gdext/src/", "gdext/tests/", "gdext/SConstruct", "gdext/site_scons/", "gdext/godot-cpp/"],
    "nativeBuild": ["-C", "gdext", "platform=macos", "target=template_debug", "arch=arm64", "dev_build=no", "-j8"],
    "regression": ["tools/ci/run_regression_checks.py", "--jobs", "4"],
    "extraCheckPattern": "^tools/ci/[a-z0-9_]+\\.py( --?[a-z0-9-]+)*$"
  },
  "paths": {
    "forbidden": [".github/", "tools/factory/", ".qodo/", "tools/ci/"],
    "needsHuman": ["tools/ci/*baseline*.json", "tools/ci/module_api/", "tools/ci/module_api_shared.json", "tools/ci/cross_domain_inventory.json"],
    "trackedBinaries": "Project/project-keynes/addons/dots_ext/bin/"
  }
}
