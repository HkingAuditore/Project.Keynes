[gd_scene format=3]
[node name="SettingsForm" type="VBoxContainer"]
theme_override_constants/separation = 8
[node name="Quality" type="OptionButton" parent="."]
layout_mode = 2
[node name="Scale" type="OptionButton" parent="."]
layout_mode = 2
[node name="VolumeLabel" type="Label" parent="."]
layout_mode = 2
text = "主音量"
theme_type_variation = &"PKMutedLabel"
[node name="Volume" type="HSlider" parent="."]
layout_mode = 2
max_value = 1.0
step = 0.01
[node name="Mute" type="CheckBox" parent="."]
layout_mode = 2
text = "静音"
