; ── V3 矿脉支配 ───────────────────────────────────────────────────────────────
; 条件：本格矿业产出占比 >= 60%（metric 38）。
; 目标：邻域 R1 的 8 格，制造业产出 +20%。
; 闭环：玩家给矿业堆产出系数 -> 矿场 last_output 升高 -> 占比升过 60% ->
; 周边工业开始加成。这是「效果作用对象跟着条件变」的核心验证。
[sub_resource type="Resource" id="InstrVeinDominance"]
script = ExtResource("4_instruction")
op = 1
value_q16 = 262144

[sub_resource type="Resource" id="CondVeinDominance"]
script = ExtResource("3_condition")
op = 2
arg0 = 38
value_q16 = 39322

[sub_resource type="Resource" id="CmdVeinDominance"]
script = ExtResource("5_command")
action = 1
domain = 2
opcode = 1
target_resolver = 1
value_mode = 1
value_q16 = 262144
duration_days = -1
stacks = 1
command_key = &"ideology.persistent"
definition_key = &"family.city.manufacturing_output_boost"

