{
  "repo": "hrhgit/Project.Keynes",
  "upstream": "HkingAuditore/Project.Keynes",
  "base": "master",
  "remote": "fork",
  "home": "~/.keynes-factory",
  "autoMerge": true,
  "autoUpdateConflicts": true,
  "labels": {
    "trigger": "ready-for-agent",
    "working": "agent-working",
    "done": "agent-done",
    "help": "agent-needs-help",
    "issueRun": "factory-issue-run"
  },
  "skipLabels": ["needs-investigation", "blocked"],
  "tools": {
    "python": "~/.local/bin/python3",
    "godot": "/opt/homebrew/bin/godot",
    "scons": "~/.local/bin/scons",
    "qodo": "~/.local/bin/qodo",
    "codex": "codex"
  },
  "agent": {
    "model": "gpt-6-luna",
    "effort": "high",
    "timeoutMinutes": 60
  },
  "limits": {
    "implementAttempts": 3,
    "localReviewRounds": 2,
    "localReviewRequired": false,
    "prReviewRounds": 3,
    "checkFixRounds": 2,
    "localReviewTimeoutMinutes": 30,
    "prReviewTimeoutMinutes": 40,
    "ciTimeoutMinutes": 40,
    "checkTimeoutMinutes": 45
  },
  "checks": {
    "staticWorkflow": ".github/workflows/runtime-checks.yml",
    "unit": [
      ["-m", "unittest", "discover", "-s", "tools/map_authoring/tests"]
    ],
    "nativePaths": ["gdext/src/", "gdext/tests/", "gdext/SConstruct", "gdext/site_scons/"],
    "nativeRebuild": "gdext/rebuild.sh",
    "nativeImport": ["--headless", "--path", "Project/project-keynes", "--import"],
    "nativeRuntimeCheck": "tools/ci/check_macos_runtime_extension.py",
    "regression": ["tools/ci/run_regression_checks.py", "--jobs", "4"],
    "extraCheckPattern": "^tools/ci/[a-z0-9_]+\\.py( --?[a-z0-9-]+| tests/[a-z0-9_/]+\\.gd)*$"
  },
  "paths": {
    "forbidden": [".github/", "tools/factory/", ".qodo/", "tools/ci/"],
    "needsHuman": ["tools/ci/*baseline*.json", "tools/ci/module_api/", "tools/ci/module_api_shared.json", "tools/ci/cross_domain_inventory.json", "gdext/godot-cpp/", "gdext/rebuild.sh"],
    "trackedBinaries": "Project/project-keynes/addons/dots_ext/bin/",
    "nativeLibraries": [
      "Project/project-keynes/addons/dots_ext/bin/macos/libdots_ext.macos.template_debug.arm64.dylib",
      "Project/project-keynes/addons/dots_ext/bin/macos/libdots_ext.macos.template_release.arm64.dylib"
    ]
  }
}
