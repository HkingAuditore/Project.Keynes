[gd_resource type="Resource" script_class="IdeologyCatalog" load_steps=30 format=3]

[ext_resource type="Script" path="res://scripts/ideology/ideology_catalog.gd" id="1_catalog"]
[ext_resource type="Script" path="res://scripts/ideology/ideology_profile.gd" id="2_profile"]
[ext_resource type="Script" path="res://scripts/ideology/ideology_definition.gd" id="3_definition"]
[ext_resource type="Script" path="res://scripts/ideology/ideology_level_definition.gd" id="4_level"]
[ext_resource type="Script" path="res://scripts/ideology/ideology_class_stance.gd" id="5_stance"]
[ext_resource type="Script" path="res://scripts/ideology/ideology_synergy_definition.gd" id="6_synergy"]
[ext_resource type="Script" path="res://scripts/effect/effect_command.gd" id="7_effect"]

[sub_resource type="Resource" id="Profile"]
script = ExtResource("2_profile")
ideology_capacity = 3
national_spirit_capacity = 2
max_transition_commands = 64

[sub_resource type="Resource" id="EffectLow"]
script = ExtResource("7_effect")
action = 1
domain = 1
opcode = 1
target_resolver = 1
value_mode = 0
value_q16 = 4096
duration_days = -1
command_key = &"ideology.persistent"
definition_key = &"country.economic_mobilization"

[sub_resource type="Resource" id="EffectHigh"]
script = ExtResource("7_effect")
action = 1
domain = 1
opcode = 1
target_resolver = 1
value_mode = 0
value_q16 = 8192
duration_days = -1
command_key = &"ideology.persistent"
definition_key = &"country.economic_mobilization"

[sub_resource type="Resource" id="EffectSynergy"]
script = ExtResource("7_effect")
action = 1
domain = 1
opcode = 1
target_resolver = 1
value_mode = 0
value_q16 = 6144
duration_days = -1
command_key = &"ideology.persistent"
definition_key = &"country.economic_mobilization"

[sub_resource type="Resource" id="LevelLow"]
script = ExtResource("4_level")
understanding_threshold_q16 = 0
daily_understanding_q16 = 8192
persistent_effects = Array[Resource]([SubResource("EffectLow")])

[sub_resource type="Resource" id="LevelHigh"]
script = ExtResource("4_level")
understanding_threshold_q16 = 196608
daily_understanding_q16 = 0
persistent_effects = Array[Resource]([SubResource("EffectHigh")])

[sub_resource type="Resource" id="CollectiveGeneral"]
script = ExtResource("5_stance")
