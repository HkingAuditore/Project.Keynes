/Build/
worklog/.index/

# ==== 误产物与 user-scope 工具（2026-11-06 skill 审计）====
# svn export 命令里的 %USERPROFILE% 没被 shell 展开时会生成这个字面量目录，
# 曾把整份 internal-tool 误提交进仓库。
/%USERPROFILE%/
**/%USERPROFILE%/

# internal-tool 是 user-scope 的团队工具（manifest 里 install_scope=user），
# 内含内网 SVN 地址与同事账号，属于本机环境而不是项目源码：不进仓库。
**/<internal-tool>/

# Windows 的 dots_ext 由本机构建（.gdextension 指向 dots_ext_maint_v1 / dots_ext_relief_v1），
# 不进仓库；历史上入库的一次性调试构建已于 2026-11-14 清理。
Project/*/addons/dots_ext/bin/windows/

# 智能体工作区/审计副本：整份项目快照，纯冗余，永不入库。
.codex-temp/
.dsh/tmp/
# GDExtension 增量编译产物。
gdext/src/*.obj
gdext/src/*.pdb
# 被挪出源码树、尚未接线的实现（harness 停放区）。
gdext/.wip/
# 本机编译日志。
gdext/build_*.log
gdext/*.err.log
# SCons 生成的 build id 头（文件头自称 "Do not edit; do not commit"）。
# 生成器已不在 SConstruct 里，残留文件会被 pk_build_id.h 的 __has_include 捡进二进制，
# 把旧 sha + 旧时间焊进库（2026-11-25 实测：.so 自报 4c02642b0+20261123T144353Z，
# 而 4c02642b0 不在 master 上）。包标识一律用 apk sha256，不要用 PK_BUILD_ID。
gdext/src/pk_build_id_generated.h

# ==== 构建产物与验证输出（2026-11-17：从索引移除，只停止跟踪，工作区文件不动）====
