[node name="StrataPage" type="VBoxContainer"]
size_flags_horizontal = 3
theme_override_constants/separation = 14
script = ExtResource("1_script")
chapter_id = "strata"

[node name="Body" type="GridContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 24
theme_override_constants/v_separation = 18
columns = 2

[node name="ListColumn" type="VBoxContainer" parent="Body"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 0
theme_override_constants/separation = 8

[node name="ListKicker" type="Label" parent="Body/ListColumn"]
