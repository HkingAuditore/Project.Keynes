[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/components/construction_picker.gd" id="1"]

[node name="ConstructionPicker" type="PanelContainer"]
theme_type_variation = &"PKInsetPanel"
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 10

[node name="Root" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Title" type="Label" parent="Margin/Root"]
layout_mode = 2
text = "国库资助修建"
theme_type_variation = &"PKSectionTitle"

[node name="SearchRow" type="HBoxContainer" parent="Margin/Root"]
layout_mode = 2

[node name="Search" type="LineEdit" parent="Margin/Root/SearchRow"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "搜索建筑，按 Enter"

[node name="Status" type="Label" parent="Margin/Root"]
layout_mode = 2
autowrap_mode = 2
theme_type_variation = &"PKMutedLabel"

[node name="Rows" type="VBoxContainer" parent="Margin/Root"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Pager" type="HBoxContainer" parent="Margin/Root"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 8

[node name="Prev" type="Button" parent="Margin/Root/Pager"]
layout_mode = 2
text = "上一页"

[node name="Page" type="Label" parent="Margin/Root/Pager"]
layout_mode = 2
text = "0 / 0"

[node name="Next" type="Button" parent="Margin/Root/Pager"]
layout_mode = 2
text = "下一页"
