#!/usr/bin/env python
"""SCons for the vendored FMOD-GODOT integration (`marcozee03/FMOD-GODOT` v1.1.3).

Windows/Android keep using the upstream prebuilt binaries (see
`addons/FmodGodot/bin/`); this tree exists so **Web** can be built from source:
FMOD's HTML5 SDK only ships static libraries (`*.a`), which must be linked into
the Godot web side module.

Build (from this directory):

    # Emscripten must be 4.0.20 (same version as the Godot 4.6 web templates)
    emsdk_env.bat
    scons platform=web target=template_release arch=wasm32 threads=yes \
          fmod_sdk=<repo-parent>/sdk/fmod/html5-20400

Output goes straight into the Godot project:
    addons/FmodGodot/bin/web/libFmodGodot.web.template_release.threads.wasm32.wasm

`threads=yes` must match the Web export preset's `variant/thread_support=true`
and the `pthreads` FMOD archives; a pthread ABI mismatch makes the side module
fail to load with a bare "failed to load dynamic library".
"""
import os

libname = "FmodGodot"

env = SConscript("../godot-cpp/SConstruct")

fmod_sdk = ARGUMENTS.pop("fmod_sdk", "<repo-parent>/sdk/fmod/html5-20400")

env.Append(CPPPATH=[
    "src/",
    "src/scene/",
    "src/audio_streams/",
    "src/scene/2d/",
    "src/scene/3d",
    "src/binding/studio",
    "src/binding/",
    "headers/",
])

# godot-cpp headers (the generated ones live under gen/include).
env.Append(CPPPATH=[
    env.Dir("../godot-cpp/include/godot_cpp"),
    env.Dir("../godot-cpp/gen/include/godot_cpp"),
])

sources = [
    Glob("src/*.cpp"),
    Glob("src/scene/*.cpp"),
    Glob("src/audio_streams/*.cpp"),
    Glob("src/scene/2d/*.cpp"),
    Glob("src/scene/3d/*.cpp"),
    Glob("src/binding/*.cpp"),
    Glob("src/binding/studio/*.cpp"),
]

if env["target"] == "editor":
    env.Append(CPPPATH=["src/editor/", "src/editor/plugins/", "src/editor/nodes/"])
    sources.append([
        Glob("src/editor/*.cpp"),
        Glob("src/editor/plugins/*.cpp"),
        Glob("src/editor/nodes/*.cpp"),
    ])

if env.get("is_msvc", False):
    env.Append(CXXFLAGS=["/std:c++20"])
else:
    env.Append(CXXFLAGS=["-std=c++20"])


def web_config():
    """Link FMOD's HTML5 static archives.

    2.03.15 布局: api/{core,studio}/lib/w32/fmod[studio]{,P,L,PL}_wasm.a
    2.04.00 布局: api/{core,studio}/lib/browser/{pthreads,single_threaded}/c_cpp/*.a
    两种都支持，按目录存在与否自动选。
    """
    if env["platform"] != "web":
        return
    threaded = ARGUMENTS.get("threads", "no") in ("yes", "true", "1")
    logging = "L" if env["target"] in ("editor", "template_debug") else ""
    legacy_dir = os.path.join(fmod_sdk, "api/studio/lib/w32")
    if os.path.isdir(legacy_dir):
        prefix = "P" if threaded else ""
        studio = os.path.join(legacy_dir, "fmodstudio%s%s_wasm.a" % (prefix, logging))
        core = os.path.join(fmod_sdk, "api/core/lib/w32", "fmod%s%s_wasm.a" % (prefix, logging))
    else:
        flavour = "pthreads" if threaded else "single_threaded"
        prefix = "P" if threaded else ""
        studio = os.path.join(fmod_sdk, "api/studio/lib/browser", flavour, "c_cpp",
                              "fmodstudio%s%s.a" % (prefix, logging))
        core = os.path.join(fmod_sdk, "api/core/lib/browser", flavour, "c_cpp",
                            "fmod%s%s.a" % (prefix, logging))
    # studio 归档里通常已经带了 core 符号；只有缺符号时才补 core（见下面 duplicate 注释）。
    archives = (studio,)
    for archive in archives:
        if not os.path.exists(archive):
            raise SCons.Errors.UserError("missing FMOD HTML5 archive: %s" % archive)
    env.Append(CPPPATH=[
        os.path.join(fmod_sdk, "api/core/inc"),
        os.path.join(fmod_sdk, "api/studio/inc"),
    ])
    env.Append(LINKFLAGS=list(archives) + ["-sEXPORTED_RUNTIME_METHODS=ccall,cwrap,setValue,getValue"])


web_config()

out_dir = os.path.abspath(os.path.join(
    "..", "..", "Project", "project-keynes", "addons", "FmodGodot", "bin", "web"))
threaded = ARGUMENTS.get("threads", "no") in ("yes", "true", "1")
feature = ".threads" if threaded else ""
lib_name = "lib%s.web.%s%s.%s%s" % (libname, env["target"], feature, env["arch"],
                                    env.subst("$SHLIBSUFFIX"))

library = env.SharedLibrary(os.path.join(out_dir, lib_name), source=sources)
Default(library)
