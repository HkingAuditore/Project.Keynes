/emsdk/

# FMOD Studio 本地工具目录：可随工作目录手工复制，不提交到 Git 或 LFS。
/tools/fmod-studio/

# FMOD 下载、验证工程、发布包和日志均为本地中间文件。
/tmp/fmod-*

# 嵌入式 godot-cpp 备份/临时仓库，不纳入版本管理
/gdext/godot-cpp.bak-20260830/
/gdext/godot-cpp.tmpfix/

# 回归/soak 的临时日志（下划线前缀是这些一次性抓取的约定）
/tmp/_*.txt

# Local Godot/editor and generated test projects
**/.godot/
/tmp/price_*/
*.tmp
*.TMP

