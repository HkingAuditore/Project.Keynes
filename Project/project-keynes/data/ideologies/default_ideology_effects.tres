duration_days = -1
stack_policy = 2
stack_key = &"v5_stacked_workshop"
max_stacks = 5
priority = 0
target_selector_kind = 8
target_selector_id = &""
target_selector_param = PackedInt32Array(8, 0)
cadence_days = 1
conditions = Array[Resource]([SubResource("CondStackedWorkshop")])
instructions = Array[Resource]([SubResource("InstrStackedWorkshop"), SubResource("InstrGranaryBeltEmit")])
commands = Array[Resource]([SubResource("CmdStackedWorkshop")])

; ── V6 行会垄断 ───────────────────────────────────────────────────────────────
; 条件：主导部门产出占比 >= 50% **且** 层数 >= 2。
; 目标：距离 3 跳内的 8 格，能源产出 +15%。
; 注意 conditions 是后缀求值栈，两个条件直接并列只有最后一个生效，
; 必须显式追加 BOOL_AND(6) 才会真正取交集（A, B, AND 的顺序）。
; 同时验证 param0=cap、param1=跳数 的新分工。
[sub_resource type="Resource" id="InstrGuildMonopoly"]
script = ExtResource("4_instruction")
op = 1
value_q16 = 196608

[sub_resource type="Resource" id="CondGuildMonopolyA"]
script = ExtResource("3_condition")
op = 2
arg0 = 42
value_q16 = 32768

[sub_resource type="Resource" id="CondGuildMonopolyB"]
script = ExtResource("3_condition")
op = 5
arg0 = 4
value_q16 = 131072

[sub_resource type="Resource" id="CondGuildMonopolyAnd"]
script = ExtResource("3_condition")
op = 6

