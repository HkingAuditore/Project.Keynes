func _can_handle(object: Object) -> bool:
	if object == null:
		return false
	var script := object.get_script() as Script
	return script != null and script.resource_path == CLIMATE_PROFILE_SCRIPT_PATH


func _parse_property(object: Object, type: int, name: String, hint_type: int,
		hint_string: String, usage_flags: int, wide: bool) -> bool:
	if not LABELS.has(name):
		return false
	var editor = ClimateProfileChineseProperty.new()
	var chinese_label := String(LABELS[name])
	editor.setup(type, hint_type, hint_string, chinese_label)
	add_property_editor(name, editor, false, chinese_label)
	var _unused_object := object
	var _unused_usage := usage_flags
	var _unused_wide := wide
	return true
