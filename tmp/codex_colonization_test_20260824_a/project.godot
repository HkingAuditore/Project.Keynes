; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ProjectKeynes"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameSettings="*res://scripts/game/game_settings_service.gd"
GameSave="*res://scripts/game/game_save_coordinator.gd"
GameFlow="*res://scripts/game/game_flow_service.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=10

[display]

window/size/viewport_width=1600
window/size/viewport_height=960
window/size/mode=2
window/stretch/aspect="expand"

[editor]

run/main_run_args="--use_data_core --use_data_core_weather"

[editor_plugins]

enabled=PackedStringArray("res://addons/climate_profile_inspector/plugin.cfg")

[input]

player_pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":32,"physical_keycode":32,"key_label":32,"unicode":32,"location":0,"echo":false,"script":null)
]
}
