input_good_ids = PackedStringArray("lumber", "sailcloth", "navigation_instruments")
input_quantities_per_day = PackedInt64Array(4000, 1000, 200)
output_good_ids = PackedStringArray("oceanic_vessels")
output_quantities_per_day = PackedInt64Array(500)
resource_ids = PackedStringArray()
resource_quantities_per_day = PackedInt64Array()
resource_interaction_modes = PackedStringArray()
resource_access_modes = PackedStringArray()
behavior_id = "none"
wage_policy_id = "adaptive"
wage_per_employee_per_day = 5000
