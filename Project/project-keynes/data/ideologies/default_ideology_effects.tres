instructions = Array[Resource]([SubResource("InstrIronThrone"), SubResource("InstrGranaryBeltEmit")])
commands = Array[Resource]([SubResource("CmdIronThrone")])

; ── V5 层叠工坊 ───────────────────────────────────────────────────────────────
; 条件：本实例层数 >= 3（STATE_STACK_COUNT = 4）。
; 目标：同地形连通块内 8 格，制造业 +20%。
; 这是 STATE_STACK_COUNT 的唯一用途证明：在此之前「层数 >= N 时生效」写不出来。
; stack_policy = ADD_STACK(2) + max_stacks = 5，层数由 submit_instances 的
; stack_counts 驱动，存档零新增字段。
[sub_resource type="Resource" id="InstrStackedWorkshop"]
script = ExtResource("4_instruction")
op = 1
value_q16 = 262144

[sub_resource type="Resource" id="CondStackedWorkshop"]
script = ExtResource("3_condition")
op = 5
arg0 = 4
value_q16 = 196608

[sub_resource type="Resource" id="CmdStackedWorkshop"]
script = ExtResource("5_command")
action = 1
domain = 2
opcode = 1
target_resolver = 1
value_mode = 1
value_q16 = 262144
duration_days = -1
stacks = 1
command_key = &"ideology.persistent"
definition_key = &"family.city.manufacturing_output_boost"

