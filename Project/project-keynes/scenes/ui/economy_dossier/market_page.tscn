[node name="MarketPage" type="VBoxContainer"]
size_flags_horizontal = 3
theme_override_constants/separation = 10
script = ExtResource("1_script")
chapter_id = "market"

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Kicker" type="Label" parent="Header"]
layout_mode = 2
size_flags_horizontal = 3
text = "供需热力 · 暗红为短缺，铜绿为积压，角标为价格偏离"
text_overrun_behavior = 3
theme_type_variation = &"PKDossierKicker"

[node name="CountLabel" type="Label" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PKDossierCaption"

[node name="EmptyLabel" type="Label" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
autowrap_mode = 3
theme_type_variation = &"PKDossierCaption"

[node name="Body" type="GridContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 22
theme_override_constants/v_separation = 16
columns = 2

[node name="HeatGrid" type="Control" parent="Body"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 0
script = ExtResource("2_heat")

[node name="Detail" type="PanelContainer" parent="Body"]
