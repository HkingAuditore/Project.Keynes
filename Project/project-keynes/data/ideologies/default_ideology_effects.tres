[gd_resource type="Resource" script_class="IdeologyEffectCatalog" load_steps=31 format=3]

[ext_resource type="Script" path="res://scripts/ideology/ideology_effect_catalog.gd" id="1_catalog"]
[ext_resource type="Script" path="res://scripts/ideology/ideology_effect_definition.gd" id="2_effect"]
[ext_resource type="Script" path="res://scripts/effect/effect_condition.gd" id="3_condition"]
[ext_resource type="Script" path="res://scripts/effect/effect_instruction.gd" id="4_instruction"]
[ext_resource type="Script" path="res://scripts/effect/effect_command.gd" id="5_command"]

; ─────────────────────────────────────────────────────────────────────────────
; V1..V6 是「目标对象随条件变」的机制验证卡，不是平衡内容。
; 每张卡验证一种不同的形态：
;   V1 条件 -> 幅度（全国标量）        V2 无条件 -> 邻域 R1
;   V3 产出占比 -> R1                  V4 资源专精 -> R2
;   V5 层数 -> 同地形连通块            V6 双条件 AND -> 距离 N
;
; 关键口径（metric id 见 effect_domain_catalog.gd，数组下标即 id）：
;   38 cell.sector_output_share.extractive_q16       按**产出**算的矿业占比
;   42 cell.dominant_sector_output_share_q16         按**产出**算的主导部门占比
;   44 cell.dominant_resource_stock_share_q16        主导资源存量占比
;    4 STATE_STACK_COUNT                             本实例层数（Q16）
;
; 用 38/42 而不是 27(cell.dominant_sector_share_q16)：后者数的是建筑**数量**，
; 给它加多少产出系数都不动，拿它当条件闭环永远合不上。
;
; 命令复用 family.city.* 系列 modifier key：它们同样作用于
; economy.city.building.<sector>_output_factor，功能等价。理念专属 key 留到
; 内容正式化时再拆分。
; value_q16 是「强度倍数」（Q16），最终系数 = 1 + (term.value - 1) * 强度，
; 上限 MAX_MAGNITUDE_Q16 = 4.0。
; ─────────────────────────────────────────────────────────────────────────────

[sub_resource type="Resource" id="CondGranaryBeltLevelTwo"]
script = ExtResource("3_condition")
op = 5
arg0 = 0
value_q16 = 131072

[sub_resource type="Resource" id="InstrGranaryBeltMagnitude"]
script = ExtResource("4_instruction")
op = 1
value_q16 = 104858

[sub_resource type="Resource" id="InstrGranaryBeltEmit"]
script = ExtResource("4_instruction")
op = 11
arg0 = 0

[sub_resource type="Resource" id="CmdGranaryBelt"]
script = ExtResource("5_command")
action = 1
domain = 1
opcode = 1
target_resolver = 1
value_mode = 1
value_q16 = 104858
duration_days = -1
stacks = 1
command_key = &"ideology.persistent"
definition_key = &"ideology.agrarian_reform"

[sub_resource type="Resource" id="EffectGranaryBelt"]
